# ============================================================
#  Autonomous Threat Hunter — Environment Configuration
#  Copy this file to .env and fill in your values
#  NEVER commit .env to git!
# ============================================================

# ── Neo4j ────────────────────────────────────────────────────
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=threatpassword123

# ── Kafka ────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9093

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redispass123

# ── LLM Provider ─────────────────────────────────────────────
# Set to "ollama" for local (free) or "openai" for cloud
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# OpenAI (only needed if LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini

# ── Threat Intel APIs ────────────────────────────────────────
# AlienVault OTX (free at https://otx.alienvault.com)
OTX_API_KEY=your-otx-api-key-here

# ── Application ──────────────────────────────────────────────
LOG_LEVEL=INFO
APP_ENV=development
SIMULATION_MODE=true          # Set false to connect real log sources
PREDICTION_INTERVAL_SEC=30    # How often GNN re-evaluates graph
THREAT_INTEL_POLL_MIN=15      # How often to check threat intel feeds
